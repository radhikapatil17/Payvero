# Payvero — Environment Configuration Example

# Database Settings
PAYVERO_DB_URL=jdbc:postgresql://localhost:5432/payvero
PAYVERO_DB_USER=payvero_app
PAYVERO_DB_PASSWORD=payvero_app_dev
PAYVERO_DB_MIGRATION_USER=payvero
PAYVERO_DB_MIGRATION_PASSWORD=payvero_dev

# Security & Authentication
PAYVERO_JWT_SECRET=super-secret-jwt-key-payvero-distributed-ledger-32bytes-minimum

# Web CORS
PAYVERO_ALLOWED_ORIGINS=http://localhost:5173

# Kafka & Redis
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
